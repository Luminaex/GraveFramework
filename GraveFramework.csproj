<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings and references: ..\Directory.Build.props. Version: ..\Versions.props. -->
  <PropertyGroup>
    <AssemblyName>GraveFramework</AssemblyName>
    <!-- Needed by ModsMenuPatch.cs (main-menu "installed mods" button/panel, UI Toolkit). -->
    <UseUnityUI>true</UseUnityUI>
  </PropertyGroup>

  <!-- examples\ is its own project (GraveFrameworkExamples.csproj); keep its sources out of this DLL. -->
  <ItemGroup>
    <Compile Remove="examples\**" />
    <None Remove="examples\**" />
    <EmbeddedResource Remove="examples\**" />
  </ItemGroup>

</Project>
